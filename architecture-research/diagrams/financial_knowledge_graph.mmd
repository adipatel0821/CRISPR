%% C. Financial dependency graph (ontology v1.1). Edges are scoped to analyses; generated with the engine's required_inputs map.
flowchart LR
  subgraph Facts["Fact nodes (user-provided)"]
    I1["income.take_home_monthly"]
    I2["income.variability"]
    I3["income.low_month"]
    I4["income.gross_monthly"]
    E1["expenses.essential.total"]
    E2["expenses.flexible.total (refinement)"]
    E3["expenses.current_vehicle_costs_monthly (refinement)"]
    D0["debts.count"]
    D1["debts[i].monthly_payment"]
    D2["debts[i].remaining_months"]
    D3["debts[i].paid_off_by_transaction"]
    S1["savings.liquid"]
    S2["loan.down_payment_source"]
    V1["vehicle.replaces_current (refinement)"]
    V2["vehicle.related_costs (refinement)"]
    V3["vehicle.value_estimates (optional)"]
  end

  subgraph Offer["Offer terms (via LoanOffer only)"]
    O1["principal or amount_financed (+PFC)"]
    O2["contract_rate or apr"]
    O3["term_months"]
    O4["cash_down, trade value / payoff, itemization"]
  end

  subgraph Assumptions["Assumption nodes (labeled)"]
    A1["a_pfc_zero (only if PFC unknown)"]
    A2["a_illustrative_scenarios"]
    A3["a_same_rate_assumed"]
  end

  subgraph Metrics["Metric nodes (engine v1.1)"]
    M0["F00 principal"]
    M1["F01 monthly payment"]
    M3["F03 finance charge / F03i interest"]
    M4["F04 total paid through deal"]
    M14["F14 incremental vehicle costs"]
    M9["F09 monthly left after"]
    M13["F13 savings after purchase"]
    M10["F10 reserve months after"]
    M6["F06 LTV / negative equity at start"]
    M7["F07b DTI"]
    M12["F12 equity timeline (user estimates only)"]
    MB["break-even income drop (Stage 4)"]
  end

  subgraph Analyses["Analyses (readiness)"]
    AN1["loan_cost"]
    AN2["cashflow_impact"]
    AN3["reserve_impact"]
    AN4["stress_test"]
    AN5["alternatives"]
    AN6["dti"]
    AN7["equity_timeline"]
  end

  O1 -->|required_by| M0
  A1 -.->|if PFC unknown| M0
  M0 -->|derived_from| M1
  O2 -->|required_by| M1
  O3 -->|required_by| M1
  M1 -->|derived_from| M3
  M3 -->|derived_from| M4
  O4 -->|required_by| M4
  V2 -->|improves| M14
  V1 -->|improves| M14
  E3 -->|improves| M14
  I1 -->|required_by| M9
  E1 -->|required_by| M9
  D0 -->|required_by| M9
  D1 -->|required_by| M9
  D3 -->|improves| M9
  E2 -->|improves| M9
  M1 -->|derived_from| M9
  M14 -->|derived_from| M9
  S1 -->|required_by| M13
  S2 -->|required_by| M13
  O4 -->|required_by| M13
  M13 -->|derived_from| M10
  M9 -->|derived_from| M10
  M0 -->|derived_from| M6
  I4 -->|required_by| M7
  D1 -->|required_by| M7
  V3 -->|required_by| M12
  M13 -->|derived_from| MB
  I3 -->|required_by when variable| MB
  I2 -->|improves| MB
  D2 -->|improves| MB
  A2 -.->|scenario sizes| MB
  A3 -.->|term alternatives| AN5

  M3 --> AN1
  M4 --> AN1
  M9 --> AN2
  M10 --> AN3
  MB --> AN4
  M10 --> AN5
  M7 --> AN6
  M12 --> AN7
