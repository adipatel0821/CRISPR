%% A. High-level system architecture — DecisionTwin (consistent with supervisor/system_architecture.md v1.0)
flowchart LR
  subgraph Client["Browser"]
    WEB["Next.js app (TypeScript, Tailwind, shadcn/ui, Recharts)"]
  end

  subgraph Backend["FastAPI service — /api/v1 (Python 3.12)"]
    API["Routers + Pydantic schemas (OpenAPI)"]
    subgraph Intelligence["Intelligence modules"]
      INTAKE["intake/ — ontology DAG (NetworkX), fact ledger, ranker, answer parser"]
      DOCS["documents/ — PyMuPDF, extraction, verifier"]
      EXPLAIN["explain/ — plans, templates, narration gate"]
    end
    subgraph Compute["Deterministic computation (Decimal)"]
      ENGINE["engine/ — F01–F12, flags, config"]
      SCEN["scenarios/ — catalog, runner, sensitivity, break-even"]
      CF["counterfactual/ — levers, grid, Pareto"]
    end
    LLM["llm/ — LLMClient adapter (timeouts, retries, schema validation, audit log)"]
    STORE["storage/ — SQLModel repositories"]
  end

  subgraph Persistence["Persistence"]
    DB[("SQLite (MVP) / Postgres (prod)")]
    TMP[("Session temp files (uploads, deleted after extraction)")]
  end

  subgraph Provider["Model provider"]
    GEMINI["Gemini API — structured output, document understanding"]
  end

  WEB -->|HTTPS JSON| API
  API --> INTAKE
  API --> DOCS
  API --> ENGINE
  API --> EXPLAIN
  INTAKE -->|sensitivity via partial compute| ENGINE
  DOCS -->|payment and APR checks| ENGINE
  SCEN --> ENGINE
  CF --> ENGINE
  CF --> SCEN
  INTAKE --> LLM
  DOCS --> LLM
  EXPLAIN --> LLM
  LLM -->|3 call types only| GEMINI
  INTAKE --> STORE
  DOCS --> STORE
  EXPLAIN --> STORE
  API --> STORE
  STORE --> DB
  DOCS --> TMP
