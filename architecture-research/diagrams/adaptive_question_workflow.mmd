%% D. Adaptive question-selection workflow (Stage 1 v1.1): readiness-driven, lexicographic priority
flowchart TB
  START["Answer received: typed, free text, skip, or decline"] --> KIND{"Answer type"}
  KIND -->|decline| DEC["Fact status = declined (terminal unless reopened)"]
  KIND -->|skip| SKIP["Deferred for this pass only"]
  KIND -->|typed| TYPED["FinancialFact (provided or estimated)"]
  KIND -->|free text| MODE{"LLM_DATA_MODE = paid?"}
  MODE -->|no| WIDGET["Typed widget for the same question"]
  MODE -->|yes| PARSE["LLM #1 parse → facts (whitelisted keys; debt items; low month)"]
  PARSE --> OK{"Schema valid?"}
  OK -->|no, after one retry| WIDGET
  OK -->|yes| LEDGER
  TYPED --> LEDGER["Append to ledger (supersede on change)"]
  DEC --> LEDGER
  SKIP --> PROF
  WIDGET --> START
  LEDGER --> PROF["Materialize profile"]
  PROF --> HARD{"Hard contradiction (C01 / C02 / C04 / C07)?"}
  HARD -->|yes| CLAR["Clarification question"] --> START
  HARD -->|no| SOFT{"Unacknowledged H01 deficit or H02 plausibility?"}
  SOFT -->|yes| ACK["Acknowledge once; deficit accepted and flagged"] --> START
  SOFT -->|no| READY["AnalysisReadiness per selected analysis (engine required_inputs; offer facts awaiting_offer)"]
  READY --> BLOCK{"Any blocking fact missing (not declined, not awaiting offer)?"}
  BLOCK -->|yes| PICK["Ask first by dependency_order, then key; why_we_ask = analysis it unlocks"]
  PICK --> LOG["question_log: priority_class, blocks_analyses"] --> START
  BLOCK -->|no| DONE["Return null + readiness + refinement list (curated; effect shown only with user-derived bounds)"]
