%% F. Financial computation and simulation architecture (Stages 3–5, v1.1)
flowchart LR
  subgraph Inputs["Verified inputs"]
    P["Profile facts (status provided / estimated)"]
    O["LoanOffer (ready_for_calculation)"]
    CFG["config: assumptions.yaml, scenarios.yaml (illustrative), levers.yaml"]
  end

  subgraph Engine["engine/ (Decimal, pure functions)"]
    F00["F00 principal: stated / AF+PFC / AF + a_pfc_zero"] --> F01["F01 payment on principal (vs disclosed → PAYMENT_MISMATCH)"]
    F01 --> F01s["F01s schedule"] --> F02["F02 total of payments"]
    F02 --> F03["F03 finance charge (TOP − AF) / F03i interest (TOP − principal)"] --> F04["F04 total paid through deal + breakdown (equity basis)"]
    F05["F05 APR on amount financed (warn outside 1/8 pt)"]
    F06["F06 LTV / F06d negative equity at start"]
    F13["F13 savings after purchase"]
    F14["F14 incremental vehicle costs (new − replaced)"]
    F08["F08 monthly left before"] --> F09["F09 monthly left after"]
    F01 --> F09
    F14 --> F09
    F13 --> F10["F10 reserve months after"]
    F09 --> F10
    MN["month_net(t, run): debts end on schedule; payment only with offer"]
    REQ["REQUIRED_INPUTS map → Stage 1 readiness"]
    FLAGS["Flags v1.1 (cited or informational)"]
  end

  subgraph Scenarios["scenarios/"]
    CAT["Illustrative catalog: expense spike, income cut, low month, job loss, cost rise"]
    RUN["Paired runs: without (start = savings) / with (start = F13)"]
    FLOOR["Savings floor at 0 + unfunded gap (no interest)"]
    OAT["OAT ±10% (labeled)"]
    BE["Break-even income drop, M = 3 and 6 (deficit → 0; capped)"]
  end

  subgraph Counterfactual["counterfactual/"]
    LEV["Levers: cash down (moves F13), term (same rate assumed), optional add-ons, verified offers"]
    GRID["Grid + constraints"]
    EVAL["Evaluate: engine + with-offer scenarios"]
    PAR["Pareto: finance charge, monthly left after, savings after purchase, break-even"]
    RS["Rate sensitivity statement (not an option)"]
  end

  P --> F08
  P --> F13
  P --> F14
  O --> F00
  O --> F05
  O --> F06
  CFG --> FLAGS
  CFG --> CAT
  CFG --> LEV
  MN --> RUN
  CAT --> RUN
  RUN --> FLOOR --> BE
  RUN --> OAT
  LEV --> GRID --> EVAL --> PAR
  EVAL --> F00
  EVAL --> RUN
  F01 --> RS
  F04 --> OUT["CalculationResult + ScenarioResult[] + CounterfactualResult → claims → DecisionReport"]
  BE --> OUT
  PAR --> OUT
